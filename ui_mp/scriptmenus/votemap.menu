            border                    1
            borderSize                1
            borderColor               0.95 0.72 0.21 0.6
            visible                   1
            decoration
        }
        // Vote count text
        itemDef {
            rect                      584 361 20 18 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_FILLED
            backColor                 0 0 0 0
            textFont                  UI_FONT_NORMAL
            textAlign                 ITEM_ALIGN_LEGACY_CENTER
            textAlignY                14
            textScale                 0.25
            foreColor                 0.95 0.72 0.21 1
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            exp                       text ( dvarInt( "votes_map16" ) )
            visible                   1
            decoration
        }
        // Invisible click button
        itemDef {
            rect                      460 358 146 88 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_FILLED
            backColor                 0 0 0 0
            type                      ITEM_TYPE_BUTTON
            mouseEnter                { play "mouse_over"; setDvar "hover_map16" 1; }
            mouseExit                 { setDvar "hover_map16" 0; }
            action                    { play "mouse_click"; scriptmenuresponse "map16"; }
            visible                   1
        }
    }
}
