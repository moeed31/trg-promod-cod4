#include "ui/menudef.h"
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"

{
    menuDef
    {
        name                      "character"
        rect                      0 0 640 480 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
        borderSize                1
        foreColor                 1 1 1 1
        backColor                 0 0 0 0
        borderColor               0 0 0 0
        outlineColor              0 0 0 0
        onOpen
        {
            setLocalVarInt ui_highlight_char 0;
            setLocalVarInt ui_hover_char 0;
            setDvar cg_drawGun 0;
            exec "openscriptmenu character open_character";
        }
        onESC
        {
            setLocalVarInt ui_highlight_char 0;
            setLocalVarInt ui_hover_char 0;
            setDvar cg_drawGun 1;
            exec "openscriptmenu character close_character";
            close self;
            open player_menu;
        }

        itemDef {
            rect                      0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
            style                     WINDOW_STYLE_FILLED
            foreColor                 1 1 1 1
            backColor                 0 0 0 0.28
            visible                   when ( dvarint( "sles_oldschool" ) != 1 )
            decoration
        }
        itemDef {
            rect                      0 0 270 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
            style                     WINDOW_STYLE_FILLED
            backColor                 0 0 0 0.35
            visible                   when ( dvarint( "sles_oldschool" ) != 1 )
            decoration
        }
