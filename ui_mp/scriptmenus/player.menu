#include "ui/menudef.h"



#define PERF_BUTTON_VIS( itemNum, xVal, yVal, textArg, responseArg, onFocusArg, unselCond, selCond ) \
	/* Unselected */ \
	itemDef \
	{ \
		name				"perf_btn_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 110 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		forecolor			0.93 0.93 0.93 1.0 \
		border				1 \
		bordercolor			0 0.8 1 0.6 \
		backcolor			0.1 0.1 0.1 0.8 \
		visible				when( unselCond ) \
		exp					text(textArg) \
		textfont			UI_FONT_NORMAL \
		textscale			0.23 \
		textalign			ITEM_ALIGN_CENTER \
		textaligny			15 \
		mouseEnter 			{ play "mouse_over"; \
		setitemcolor "perf_btn_" #itemNum backcolor 0 0.8 1 0.45; \
		setLocalVarString ui_hintstring "^8>> ^7"onFocusArg \
		} \
		mouseExit 			{ \
		setitemcolor "perf_btn_" #itemNum backcolor 0.1 0.1 0.1 0.8; \
		setLocalVarString ui_hintstring "^8>> ^7" \
		} \
		action 				{ play "mouse_click"; \
		scriptMenuResponse responseArg;  \
		}  \
	} \
	/* Selected */ \
	itemDef \
	{ \
		name				"perf_btn_sel_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 110 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		forecolor			0.95 0.95 0.95 1 \
		border				1 \
		bordercolor			0 0.8 0.2 0.6 \
		backcolor			0 0.4 0.1 0.85 \
		visible				when( selCond ) \
		exp					text(textArg) \
		textfont			UI_FONT_NORMAL \
		textscale			0.23 \
		textalign			ITEM_ALIGN_CENTER \
		textaligny			15 \
		mouseEnter 			{ play "mouse_over"; \
		setitemcolor "perf_btn_sel_" #itemNum backcolor 0 0.6 0.15 0.95; \
		setLocalVarString ui_hintstring "^8>> ^7"onFocusArg \
		} \
		mouseExit 			{ \
		setitemcolor "perf_btn_sel_" #itemNum backcolor 0 0.4 0.1 0.85; \
		setLocalVarString ui_hintstring "^8>> ^7" \
		} \
		action 				{ play "mouse_click"; \
		scriptMenuResponse responseArg;  \
		}  \
	}

#define FOV_BUTTON_VIS( itemNum, xVal, yVal, textArg, responseArg, onFocusArg, unselCond, selCond ) \
	/* Unselected */ \
	itemDef \
	{ \
		name				"fov_btn_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 110 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		forecolor			0.93 0.93 0.93 1.0 \
		border				1 \
