#include "ui/menudef.h"

#define ADMIN_HEADING(xPos, yPos, textArg) \
		itemDef \
		{ \
			rect			xPos yPos 140 18 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
			style			WINDOW_STYLE_SHADER \
			background		"menu_button_backg" \
			forecolor		0.95 0.72 0.21 1 \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			rect			xPos yPos 140 18 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
			textalign		ITEM_ALIGN_CENTER \
			textaligny		14 \
			textscale		0.22 \
			forecolor		0 0 0 1 \
			textstyle		ITEM_TEXTSTYLE_NORMAL \
			textfont		UI_FONT_OBJECTIVE \
			exp text		(textArg) \
			visible			1 \
			decoration \
		}

#define ADMIN_BTN(xPos, yPos, textArg, responseArg) \
		itemDef \
		{ \
			name			"admin_btn_"#responseArg \
			type 			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			xPos yPos 140 18 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
			forecolor		0.93 0.93 0.93 1.0 \
			border			1 \
			bordercolor		0.3 0.3 0.3 0.5 \
			backcolor		0.15 0.15 0.15 0.7 \
			visible			1 \
			exp				text(textArg) \
			textfont		UI_FONT_NORMAL \
			textscale		0.20 \
			textalign		ITEM_ALIGN_CENTER \
			textaligny		14 \
			mouseEnter 		{ play "mouse_over"; setitemcolor "admin_btn_"#responseArg backcolor 0.4 0.4 0.4 0.9; } \
			mouseExit 		{ setitemcolor "admin_btn_"#responseArg backcolor 0.15 0.15 0.15 0.7; } \
			action 			{ play "mouse_click"; scriptMenuResponse responseArg; }  \
		}

menuDef
{
	name			"admin"
	fullscreen		1
	rect			0 0 640 480
	focuscolor		1 1 1 1
	style			1
	blurWorld		7
	onEsc
	{
		close admin;
	}

	itemDef
	{
		style			WINDOW_STYLE_SHADER
		rect			-107 0 854 480 0 0
		background		"nightvision_overlay_goggles"
		forecolor		1 1 1 1
		visible			1
		decoration
	}

	itemDef
	{
		rect			230 45 180 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
		textalign		ITEM_ALIGN_CENTER
		textaligny		16
		textscale		0.35
		forecolor		0.95 0.72 0.21 1
		textstyle		ITEM_TEXTSTYLE_SHADOWEDMORE
		textfont		UI_FONT_OBJECTIVE
		text			"ADMIN CONTROL PANEL"
		visible			1
	}

	// --- COLUMN 1: VIP & PRESTIGE --- (x = 20)
	ADMIN_HEADING(20, 80, "VIP")
	ADMIN_BTN(20, 100, "Add to VIP 1", av_vip1)
	ADMIN_BTN(20, 120, "Add to VIP 2", av_vip2)
	ADMIN_BTN(20, 140, "Add to VIP 3", av_vip3)
	ADMIN_BTN(20, 160, "Remove from VIP", av_vip0)

	ADMIN_HEADING(20, 190, "Prestige")
	ADMIN_BTN(20, 210, "Set Prestige 0", av_pr0)
	ADMIN_BTN(20, 230, "Set Prestige 10", av_pr10)
	ADMIN_BTN(20, 250, "Set Prestige 20", av_pr20)
	ADMIN_BTN(20, 270, "Set Prestige 30", av_pr30)

	// --- COLUMN 2: XP & ADMINSHIP --- (x = 180)
	ADMIN_HEADING(180, 80, "XP")
	ADMIN_BTN(180, 100, "Give 100 XP", av_xp100)
	ADMIN_BTN(180, 120, "Give 1000 XP", av_xp1000)
	ADMIN_BTN(180, 140, "Give 10000 XP", av_xp10000)
	ADMIN_BTN(180, 160, "Take 100 XP", av_txp100)
	ADMIN_BTN(180, 180, "Take 1000 XP", av_txp1000)
	ADMIN_BTN(180, 200, "Take 10000 XP", av_txp10000)

	ADMIN_HEADING(180, 230, "Adminship")
	ADMIN_BTN(180, 250, "Add to Member", member)
	ADMIN_BTN(180, 270, "Add to Senior", senior)
	ADMIN_BTN(180, 290, "Add to Leader", leader)

	// --- COLUMN 3: RR & MALICIOUS --- (x = 340)
	ADMIN_HEADING(340, 80, "RR")
	ADMIN_BTN(340, 100, "Give 100 rr", av_rr100)
	ADMIN_BTN(340, 120, "Give 1000 rr", av_rr1000)
	ADMIN_BTN(340, 140, "Give 10000 rr", av_rr10000)
	ADMIN_BTN(340, 160, "Take 100 rr", av_trr100)
	ADMIN_BTN(340, 180, "Take 1000 rr", av_trr1000)
	ADMIN_BTN(340, 200, "Take 10000 rr", av_trr10000)

	ADMIN_HEADING(340, 230, "Malicious")
	ADMIN_BTN(340, 250, "Respawn", av_respawn)
	ADMIN_BTN(340, 270, "Kill", akill)
	ADMIN_BTN(340, 290, "WTF", av_wtf)
	ADMIN_BTN(340, 310, "TP to You", atpto)

	itemDef
	{
		name				"pitem_0"
		type 				ITEM_TYPE_BUTTON
		style				WINDOW_STYLE_FILLED
		rect				500 78 130 11 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
		backcolor			0.15 0.15 0.15 0.7
		border				1
		bordercolor			0.3 0.3 0.3 0.5
		exp					text(dvarString("ui_player0"))
		textfont			UI_FONT_NORMAL
		textscale			0.18
		textalign			ITEM_ALIGN_CENTER
		textaligny			9
		forecolor			0.93 0.93 0.93 0.85
		mouseEnter 			{ play "mouse_over"; setitemcolor "pitem_0" backcolor 0.4 0.4 0.4 0.9; }
		mouseExit 			{ setitemcolor "pitem_0" backcolor 0.15 0.15 0.15 0.7; }
		action 				{ play "mouse_click"; scriptMenuResponse player0; }
		visible 			when(dvarString("ui_player0") != "")
	}

