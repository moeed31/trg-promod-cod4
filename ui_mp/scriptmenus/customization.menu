#include "ui/menudef.h"

#define HIT_IMAGE_VIS( itemNum, xVal, yVal, shaderName, responseArg, onFocusArg, unselCond, selCond ) \
	/* Unselected Image */ \
	itemDef \
	{ \
		style				WINDOW_STYLE_SHADER \
		rect				xVal yVal 35 35 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		background			shaderName \
		forecolor			1 1 1 0.5 \
		border				1 \
		bordercolor			0.3 0.3 0.3 0.5 \
		visible				when( unselCond ) \
		decoration \
	} \
	/* Selected Image */ \
	itemDef \
	{ \
		style				WINDOW_STYLE_SHADER \
		rect				xVal yVal 35 35 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		background			shaderName \
		forecolor			0.95 0.95 0.95 1 \
		border				1 \
		bordercolor			0.95 0.72 0.21 1 \
		visible				when( selCond ) \
		decoration \
	} \
	/* Interactive Button Overlay */ \
	itemDef \
	{ \
		name				"hit_btn_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 35 35 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		backcolor			0 0 0 0 \
		visible				1 \
		mouseEnter 			{ play "mouse_over"; \
		setLocalVarString ui_hintstring "^8>> ^7"onFocusArg \
		} \
		mouseExit 			{ \
		setLocalVarString ui_hintstring "^8>> ^7" \
		} \
		action 				{ play "mouse_click"; \
		scriptMenuResponse  responseArg;  \
		}  \
	}

#define HUD_IMAGE_VIS( itemNum, xVal, yVal, shaderName, colorVal, responseArg, onFocusArg, unselCond, selCond ) \
	/* Background box */ \
	itemDef \
	{ \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 70 44 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		backcolor			0.05 0.05 0.05 0.8 \
		border				1 \
		bordercolor			0.3 0.3 0.3 0.5 \
		visible				when( unselCond ) \
		decoration \
	} \
	itemDef \
	{ \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 70 44 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		backcolor			0.05 0.05 0.05 0.8 \
		border				1 \
		bordercolor			0.95 0.72 0.21 1 \
		visible				when( selCond ) \
		decoration \
	} \
	/* The actual shader image */ \
	itemDef \
	{ \
		style				WINDOW_STYLE_SHADER \
		rect				(xVal+2) (yVal+2) 66 40 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		background			shaderName \
		forecolor			colorVal 0.6 \
		visible				when( unselCond ) \
		decoration \
	} \
	itemDef \
	{ \
		style				WINDOW_STYLE_SHADER \
		rect				(xVal+2) (yVal+2) 66 40 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		background			shaderName \
		forecolor			colorVal 1.0 \
		visible				when( selCond ) \
		decoration \
	} \
	/* Interactive Button Overlay */ \
	itemDef \
	{ \
		name				"hud_btn_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 70 44 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		backcolor			0 0 0 0 \
		visible				1 \
		mouseEnter 			{ play "mouse_over"; \
		setLocalVarString ui_hintstring "^8>> ^7"onFocusArg \
		} \
		mouseExit 			{ \
		setLocalVarString ui_hintstring "^8>> ^7" \
		} \
		action 				{ play "mouse_click"; \
		scriptMenuResponse  responseArg;  \
		}  \
	}

#define KCARD_IMAGE_VIS( itemNum, xVal, yVal, shaderName, colorVal, textLabel, responseArg, onFocusArg, unselCond, selCond ) \
	/* The actual shader image (Unselected) */ \
	itemDef \
	{ \
		style				WINDOW_STYLE_SHADER \
		rect				xVal yVal 90 30 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		background			shaderName \
		forecolor			colorVal 0.5 \
		border				1 \
		bordercolor			0.3 0.3 0.3 0.5 \
		visible				when( unselCond ) \
		decoration \
	} \
	/* The actual shader image (Selected) */ \
	itemDef \
	{ \
		style				WINDOW_STYLE_SHADER \
		rect				xVal yVal 90 30 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		background			shaderName \
		forecolor			colorVal 1.0 \
		border				1 \
		bordercolor			0.95 0.72 0.21 1 \
		visible				when( selCond ) \
		decoration \
	} \
	/* Interactive Button Overlay */ \
	itemDef \
	{ \
		name				"kcard_btn_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				xVal yVal 90 30 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		backcolor			0 0 0 0 \
		visible				1 \
		mouseEnter 			{ play "mouse_over"; \
		setLocalVarString ui_hintstring "^8>> ^7"onFocusArg \
		} \
		mouseExit 			{ \
		setLocalVarString ui_hintstring "^8>> ^7" \
		} \
		action 				{ play "mouse_click"; \
		scriptMenuResponse  responseArg;  \
		}  \
	}

#include "ui_mp/menustyle.inc"

{
	menuDef 
