#include "ui/menudef.h"
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"
#include "ui_mp/spray_common.inc"	

{
	menuDef
	{
		name			"sprays"
		rect			0 0 640 480
		focuscolor		COLOR_FOCUSED
		style			WINDOW_STYLE_EMPTY
		blurWorld		7
		visible			1
		onEsc
		{
			close self;
			open player_menu;
		}

		
		// 1. Deep Black Immersive Background
        itemDef
        {
            style                     WINDOW_STYLE_FILLED
            rect                      0 0 530 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
            backColor                 0 0 0 0.75
            visible                   1
            decoration                
        }
        
        // 2. Animated Fog Background
        itemDef
        {
            rect                      -107 0 1708 480 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            borderSize                1
            foreColor                 1 1 1 0.7
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            background                "animbg_fogscroll"
            textScale                 0.55
            exp                       rect X ( ( ( ( - 107 ) - ( ( float( milliseconds( ) % 60000 ) / 60000 ) * ( 854 ) ) ) ) );
            visible                   when ( ( dvarint( "sles_oldschool" ) != 1 ) )
            decoration                
        }
        itemDef
        {
            rect                      -107 0 1708 480 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            borderSize                1
            foreColor                 1 1 1 0.7
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            background                "animbg_fogscrollthin"
            textScale                 0.55
            exp                       rect X ( ( ( ( - 961 ) + ( ( float( milliseconds( ) % 100000 ) / 100000 ) * ( 854 ) ) ) ) );
            visible                   when ( ( dvarint( "sles_oldschool" ) != 1 ) )
            decoration                
        }
        
        // 3. Dark Overlay
        itemDef
        {
            rect                      0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
            style                     WINDOW_STYLE_FILLED
            borderSize                1
            foreColor                 1 1 1 1
            backColor                 0 0 0 0.28
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            textScale                 0.55
            visible                   when ( ( dvarint( "sles_oldschool" ) != 1 ) )
            decoration                
        }
        
        // 5. Left Panel Edge Glow (Width 530)
        itemDef
        {
            rect                      210 0 1 480 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_TOP
            style                     WINDOW_STYLE_SHADER
            borderSize                1
            foreColor                 1 1 1 0.8
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            textScale                 0.55
            exp                       material ( ( ( "button_highlight_end" ) ) );
            visible                   when ( ( dvarint( "sles_oldschool" ) != 1 ) )
            decoration                
        }
        itemDef
        {
            rect                      210 0 8 480 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_TOP
            style                     WINDOW_STYLE_SHADER
            borderSize                1
            foreColor                 1 1 1 0.75
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            textScale                 0.55
            exp                       material ( ( ( "gradient" ) ) );
            visible                   when ( ( dvarint( "sles_oldschool" ) != 1 ) )
            decoration                
        }

        // Title (Matching Modern Layout)
        itemDef
        {
            rect                      30 18 360 30 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            borderSize                1
            foreColor                 0.445 0.457 0.527 0.4
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            background                "menu_button_backg"
            textScale                 0.55
            visible                   1
            decoration                
        }
        itemDef
        {
            rect                      30 45 360 6 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            borderSize                1
            foreColor                 1 1 1 1
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            textScale                 0.55
            exp                       material ( ( ( "menu_button_backg" ) ) );
            visible                   1
            decoration                
        }
        itemDef
        {
            rect                      30 18 360 30 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            borderSize                1
            foreColor                 0.95294 0.72156 0.21176 1
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_MIDDLE_RIGHT
            textAlignX                -10
            textScale                 0.51
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            text                      "CUSTOM UNLOCKS & SKINS"
            visible                   1
        }
        
		// Subtle Semtex logo watermark in background of selections
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect 158 159 236 113 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			background		"semtex_logo"
			forecolor 1 1 1 0.3
			visible			1
			decoration
		}

		// Prestige dynamic status icon & text in header
		itemDef
		{
			rect 72 392 243 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			forecolor		0.93 0.93 0.93 0.85
			textfont		UI_FONT_NORMAL
			textscale 0.5
			textstyle  		ITEM_TEXTSTYLE_SHADOWED
			exp text        ("PRESTIGE LEVEL: ^5"+ stat(2326) + " ^7| REWARD TIER: ^5" + stat(3252))
			visible			1
			decoration
		}
		itemDef 
		{
			rect 27 367 41 33 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			style			WINDOW_STYLE_SHADER
			exp				material( tablelookup( "mp/rankIconTable.csv", 0, stat(252), stat(2326)+1 ) )
			visible			1
			decoration
		}

		// =========================================================================
		// TOP PANEL CARD - SPRAYS GRID
		// =========================================================================

		itemDef 
		{
			style			WINDOW_STYLE_SHADER
			rect			30 52 490 16 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			background		"menu_button_backg"
			forecolor		1 1 1 0.4
			visible			1
			decoration
		}
		itemDef
		{
			rect			35 64 480 0 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			forecolor		1 1 1 0.95
			textstyle  		ITEM_TEXTSTYLE_SHADOWED
			textfont 		UI_FONT_OBJECTIVE
			textscale 		0.26
			text            "SELECT IN-GAME SPRAY DESIGN"
			visible         1
			decoration
		}

		// Spray grid matrix (drawn by spray_common.inc macros)
		SPRAY( 0, 0, 1 ) 
		SPRAY( 1, 0, 2 )
		SPRAY( 2, 0, 3 )
		SPRAY( 3, 0, 4 )
		SPRAY( 4, 0, 5 )
		SPRAY( 5, 0, 6 )
		SPRAY( 6, 0, 7 )
		SPRAY( 7, 0, 8 ) 
		SPRAY( 8, 0, 9 )
		SPRAY( 9, 0, 10 )
		SPRAY( 0, 1, 11 )
		SPRAY( 1, 1, 12 )
		SPRAY( 2, 1, 13 )
		SPRAY( 3, 1, 14 )
		SPRAY( 4, 1, 15 ) 
		SPRAY( 5, 1, 16 )
		SPRAY( 6, 1, 17 )
		SPRAY( 7, 1, 18 )
		SPRAY( 8, 1, 19 )		
		SPRAY( 9, 1, 20 )

		// =========================================================================
		// BOTTOM PANEL CARD - SEASON INFO
		// =========================================================================

		itemDef
		{
			rect			30 340 500 45 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			forecolor		0.85 0.85 0.85 0.95
			textfont		UI_FONT_NORMAL
			textalign		ITEM_ALIGN_LEFT
			textscale		0.22
			exp text		("Welcome to the 2026 season. If your prestige was higher than 20, you are eligible for season\nawards. Check your awards in the VIP menu! Seasons rotate on a yearly basis.")
			autowrapped
			visible			1
			decoration
		}

		// =========================================================================
		// RIGHT PREVIEW PANEL CARD
		// =========================================================================

		itemDef
        {
            rect -99 10 98 30 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_SUBTOP
            borderSize                1
            foreColor                 0.95294 0.72156 0.21176 1
            backColor                 0 0 0 0
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_MIDDLE_RIGHT
            textAlignX                -10
            textScale                 0.51
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            text                      "PREVIEW"
            visible                   1
        }
        
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect 540 45 90 16 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			background		"menu_button_backg"
			forecolor		1 1 1 0.4
			visible			1
			decoration
		}
		itemDef
		{
			rect			540 45 90 16 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			textalign		ITEM_ALIGN_LEFT
			textaligny		12
			textscale		0.18
			forecolor		0.93 0.93 0.93 0.7
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textfont		UI_FONT_NORMAL
			text			"SELECTED SPRAY:"
			visible			1
			decoration
		}

		// Spray Label & Shader preview
		itemDef
		{
			rect			550 72 75 12 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			textalign		ITEM_ALIGN_CENTER
			textscale		0.16
			forecolor		0.93 0.93 0.93 0.6
			text			"Active Spray"
			visible			1
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect 538 94 93 82 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			exp				material( tableLookup( SPRAY_TABLE, 0, Stat(979) + 1, 3 ) )
			border			1
			bordercolor		0.3 0.3 0.3 0.5
			visible			1
			decoration
		}

		
		// BACK BUTTON at the bottom left
		itemDef
		{
			rect			70 440 220 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
			style			WINDOW_STYLE_SHADER
			borderSize		1
			foreColor		0.445 0.457 0.527 0.4
			backColor		0 0 0 0
			borderColor		0 0 0 0
			outlineColor	0 0 0 0
			background		"menu_button_backg"
			textScale		0.55
			visible			1
			decoration		
		}
		itemDef
		{
			name			"back_btn_glow"
			rect			70 440 220 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
			style			WINDOW_STYLE_SHADER
			borderSize		1
			foreColor		0 0 0 0
			backColor		0 0 0 0
			borderColor		0 0 0 0
			outlineColor	0 0 0 0
			background		"menu_button_backg"
			textScale		0.55
			visible			1
			decoration		
		}
		itemDef
		{
			name			"back_btn"
			rect			70 440 220 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
			type			ITEM_TYPE_BUTTON
			borderSize		1
			foreColor		1 1 1 1
			backColor		0 0 0 0
			borderColor		0 0 0 0
			outlineColor	0 0 0 0
			textFont		UI_FONT_OBJECTIVE
			textAlign		ITEM_ALIGN_MIDDLE_RIGHT
			textAlignX		-25
			textScale		0.45
			textStyle		ITEM_TEXTSTYLE_SHADOWED
			text			"BACK"
			visible			1
			action			{ play "mouse_click"; close self; open player_menu; }
			mouseEnter		{ play "mouse_over"; setitemcolor "back_btn_glow" foreColor 1 1 1 1; }
			mouseExit		{ setitemcolor "back_btn_glow" foreColor 0 0 0 0; }
		}

		// Watermark logo
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect -111 -60 101 50 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_BOTTOM
			background		"semtex_logo"
			forecolor 1 1 1 1
			visible			1
			decoration
		}
	}
}