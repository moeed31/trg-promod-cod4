#include "ui/menudef.h"
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"
#include "ui_mp/trail_common.inc"	

{
    menuDef
    {
        name                      "knife_customization"
        rect                      0 0 640 480 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
        borderSize                1
        foreColor                 1 1 1 1
        backColor                 0 0 0 0
        borderColor               0 0 0 0
        outlineColor              0 0 0 0
        onOpen
        {
            setLocalVarInt ui_highlight_trail 0;
            setLocalVarInt ui_hover_trail 0;
            setDvar cg_drawGun 0;
            exec "openscriptmenu knife_customization open_trails";
        }
        onESC
        {
            setLocalVarInt ui_highlight_trail 0;
            setLocalVarInt ui_hover_trail 0;
            setDvar cg_drawGun 1;
            exec "openscriptmenu knife_customization close_trails";
            close self;
            open player_menu;
        }

        // Dark Overlay (Full screen)
        itemDef
        {
            rect                      0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
            style                     WINDOW_STYLE_FILLED
            borderSize                1
            foreColor                 1 1 1 1
            backColor                 0 0 0 0.28
            borderColor               0 0 0 0
            outlineColor              0 0 0 0
            textScale                 0.55
            visible                   when ( ( dvarint( "sles_oldschool" ) != 1 ) )
            decoration                
        }
        
