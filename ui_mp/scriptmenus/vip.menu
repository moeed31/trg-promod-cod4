			visible			when( dvarString("ui_killcard") == "VIP3" )
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect 538 356 94 38 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			background		"black"
			border			1
			bordercolor		0.3 0.3 0.3 0.5
			visible			when( dvarString("ui_killcard") != "VIP1" && dvarString("ui_killcard") != "VIP2" && dvarString("ui_killcard") != "VIP3" )
			decoration
		}

		// BACK BUTTON at the bottom left
		itemDef
		{
			rect			70 440 220 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
			style			WINDOW_STYLE_SHADER
			borderSize		1
			foreColor		0.445 0.457 0.527 0.4
			backColor		0 0 0 0
			borderColor		0 0 0 0
			outlineColor	0 0 0 0
			background		"menu_button_backg"
			textScale		0.55
			visible			1
			decoration		
		}
		itemDef
		{
			name			"back_btn_glow"
			rect			70 440 220 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
			style			WINDOW_STYLE_SHADER
			borderSize		1
			foreColor		0 0 0 0
			backColor		0 0 0 0
			borderColor		0 0 0 0
			outlineColor	0 0 0 0
			background		"menu_button_backg"
			textScale		0.55
			visible			1
			decoration		
		}
		itemDef
		{
			name			"back_btn"
			rect			70 440 220 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
			type			ITEM_TYPE_BUTTON
			borderSize		1
			foreColor		1 1 1 1
			backColor		0 0 0 0
			borderColor		0 0 0 0
			outlineColor	0 0 0 0
			textFont		UI_FONT_OBJECTIVE
			textAlign		ITEM_ALIGN_MIDDLE_RIGHT
			textAlignX		-25
			textScale		0.45
			textStyle		ITEM_TEXTSTYLE_SHADOWED
			text			"BACK"
			visible			1
			action			{ play "mouse_click"; close self; open player_menu; }
			mouseEnter		{ play "mouse_over"; setitemcolor "back_btn_glow" foreColor 1 1 1 1; }
			mouseExit		{ setitemcolor "back_btn_glow" foreColor 0 0 0 0; }
		}

		// Watermark logo
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect -111 -60 101 50 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_BOTTOM
			background		"semtex_logo"
			forecolor		1 1 1 0.2
			visible			1
			decoration
		}
}
}
