                setLocalVarInt ui_highlight_glove 59;
                exec "openscriptmenu gloves select_59";
            }
        }

        itemDef {
            rect                      -40 416 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            foreColor                 0.445 0.457 0.527 0.4
            background                "menu_button_backg"
            visible                   1
            decoration
        }
        itemDef {
            rect                      -40 416 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            foreColor                 0.445 0.457 0.527 1
            background                "menu_button_backg"
            visible                   when ( localvarint( "ui_hover_glove" ) == 60 )
            decoration
        }
        itemDef {
            rect                      -40 416 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            foreColor                 0.2 0.8 0.2 1
            background                "menu_button_backg"
            visible                   when ( stat( 980 ) == 19 )
            decoration
        }
        
        itemDef {
            rect                      -40 416 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            foreColor                 1 1 1 1
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_MIDDLE_RIGHT
            textAlignX                -25
            textScale                 0.35
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            text                      "Glove Style 20"
            visible                   when ( tableLookup(CHAR_TABLE, 0, 20, 2) == "" || plevel >= tableLookup(CHAR_TABLE, 0, 20, 2) )
            decoration
        }
        itemDef {
            rect                      -40 416 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            foreColor                 0.5 0.5 0.5 1
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_MIDDLE_RIGHT
            textAlignX                -25
            textScale                 0.35
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            text                      "Glove Style 20"
            visible                   when ( tableLookup(CHAR_TABLE, 0, 20, 2) != "" && plevel < tableLookup(CHAR_TABLE, 0, 20, 2) )
            decoration
        }
        
        itemDef {
            rect                      320 200 280 40 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            foreColor                 1 0.2 0.2 1
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_CENTER
            textScale                 0.8
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            text                      "LOCKED"
            visible                   when ( localvarint( "ui_highlight_glove" ) == 60 && tableLookup(CHAR_TABLE, 0, 20, 2) != "" && plevel < tableLookup(CHAR_TABLE, 0, 20, 2) )
            decoration
        }
        itemDef {
            rect                      320 230 280 20 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            foreColor                 1 1 1 0.8
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_CENTER
            textScale                 0.4
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            exp                       text( "Requires Prestige " + (tableLookup(CHAR_TABLE, 0, 20, 2) - 1) )
            visible                   when ( localvarint( "ui_highlight_glove" ) == 60 && tableLookup(CHAR_TABLE, 0, 20, 2) != "" && plevel < tableLookup(CHAR_TABLE, 0, 20, 2) )
            decoration
        }

        itemDef {
            rect                      -40 416 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            type                      ITEM_TYPE_BUTTON
            visible                   1
            onFocus {
                play "mouse_over";
                setLocalVarInt ui_hover_glove 60;
            }
            leaveFocus {
                setLocalVarInt ui_hover_glove 0;
            }
            mouseEnter {
                play "mouse_over";
                setLocalVarInt ui_hover_glove 60;
            }
            action {
                play "mouse_click";
                setLocalVarInt ui_highlight_glove 60;
                exec "openscriptmenu gloves select_60";
            }
        }

        itemDef {
            rect                      -40 440 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            foreColor                 0.445 0.457 0.527 0.4
            background                "menu_button_backg"
            visible                   1
            decoration
        }
        itemDef {
            rect                      -40 440 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            style                     WINDOW_STYLE_SHADER
            foreColor                 0.445 0.457 0.527 1
            background                "menu_button_backg"
            visible                   when ( localvarint( "ui_hover_back" ) == 1 )
            decoration
        }
        itemDef {
            rect                      -40 440 300 19 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            type                      ITEM_TYPE_BUTTON
            style                     WINDOW_STYLE_FILLED
            foreColor                 1 1 1 1
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_MIDDLE_RIGHT
            textAlignX                -25
            textScale                 0.35
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            text                      "BACK"
            visible                   1
            onFocus {
                play "mouse_over";
                setLocalVarInt ui_hover_back 1;
            }
            leaveFocus {
                setLocalVarInt ui_hover_back 0;
            }
            mouseEnter {
                play "mouse_over";
                setLocalVarInt ui_hover_back 1;
            }
            action {
                play "mouse_click";
                setDvar cg_drawGun 1;
                exec "openscriptmenu gloves close_gloves";
                close self;
                open player_menu;
            }
        }
    }
}
