#define BUTTON_TOGGLE_LOCK(itemNum,responseArg,onFocusArg) \
	itemDef \
	{ \
		name				"pres_btn_lock_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				(45 + COL4( itemNum ) * 120) (278 + ROW4( itemNum )*24) 110 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		forecolor			0.93 0.93 0.93 1.0 \
		border				1 \
		bordercolor			0.3 0.3 0.3 0.5 \
		backcolor			0 0 0 0.25 \
		visible				when(stat(3110) == 0) \
		text				"Toggle reset lock" \
		textfont			UI_FONT_NORMAL \
		textscale			0.23 \
		textalign			ITEM_ALIGN_CENTER \
		textaligny			15 \
		mouseEnter 			{ play "mouse_over"; setitemcolor "pres_btn_lock_" #itemNum backcolor 0.3 0.3 0.3 0.5; setLocalVarString ui_hintstring "^8>> ^7"onFocusArg } \
		mouseExit 			{ setitemcolor "pres_btn_lock_" #itemNum backcolor 0 0 0 0.25; setLocalVarString ui_hintstring "^8>> ^7" } \
		action 				{ play "mouse_click"; scriptMenuResponse responseArg; }  \
	} \
	itemDef \
	{ \
		name				"pres_btn_unlock_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				(45 + COL4( itemNum ) * 120) (278 + ROW4( itemNum )*24) 110 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		forecolor			0.2 1.0 0.2 1.0 \
		border				1 \
		bordercolor			0.3 0.3 0.3 0.5 \
		backcolor			0 0 0 0.25 \
		visible				when(stat(3110) == 1) \
		text				"RESET UNLOCKED" \
		textfont			UI_FONT_NORMAL \
		textscale			0.23 \
		textalign			ITEM_ALIGN_CENTER \
		textaligny			15 \
		mouseEnter 			{ play "mouse_over"; setitemcolor "pres_btn_unlock_" #itemNum backcolor 0.3 0.3 0.3 0.5; setLocalVarString ui_hintstring "^8>> ^7"onFocusArg } \
		mouseExit 			{ setitemcolor "pres_btn_unlock_" #itemNum backcolor 0 0 0 0.25; setLocalVarString ui_hintstring "^8>> ^7" } \
		action 				{ play "mouse_click"; scriptMenuResponse responseArg; }  \
	}
