		} \
		action 				{ play "mouse_click"; \
		scriptMenuResponse responseArg; close self;\
		}  \
	}
	
#define BUTTON_3(itemNum,textArg,responseArg,onFocusArg,statVal) \
	itemDef \
	{ \
		name				"act_btn_" #itemNum \
		type 				ITEM_TYPE_BUTTON \
		style				WINDOW_STYLE_FILLED \
		rect				(45 + (itemNum==6)*170) 178 160 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP \
		forecolor			0.93 0.93 0.93 1.0 \
		border				1 \
		bordercolor			0.3 0.3 0.3 0.5 \
		backcolor			0 0 0 0.25 \
		visible				when(statVal >= 1) \
		exp					text(textArg) \
		textfont			UI_FONT_NORMAL \
		textscale			0.22 \
		textalign			ITEM_ALIGN_CENTER \
		textaligny			15 \
		mouseEnter 			{ play "mouse_over"; \
		setitemcolor "act_btn_" #itemNum backcolor 0.3 0.3 0.3 0.5; \
		setLocalVarString ui_hintstring "^8>> ^7"onFocusArg \
		} \
		mouseExit 			{ \
		setitemcolor "act_btn_" #itemNum backcolor 0 0 0 0.25; \
		setLocalVarString ui_hintstring "^8>> ^7" \
		} \
		action 				{ play "mouse_click"; \
		scriptMenuResponse responseArg;  \
		close self; \
		}  \
	}

