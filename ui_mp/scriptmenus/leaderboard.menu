// --- MODERN STYLE OVERRIDES ---
#undef CHOICE_Y_SPACING
#define CHOICE_Y_SPACING		(CHOICE_SIZE_Y+7)

#undef HIGHLIGHT_SHADER
#define HIGHLIGHT_SHADER		"menu_button_backg"

#undef HIGHLIGHT_COLOR
#define HIGHLIGHT_COLOR			0.445 0.457 0.527 1

#undef CHOICE_BUTTON_BG
#define CHOICE_BUTTON_BG( itemIndex, visArg ) \
    itemDef { \
        style           WINDOW_STYLE_SHADER \
        rect            CHOICE_RECT( itemIndex ) \
        background      "menu_button_backg" \
        forecolor       0.445 0.457 0.527 0.4 \
        visible         visArg \
        decoration }
