{
	menuDef
	{
		name			"leaderboard"
		rect			0 0 640 480
		focuscolor		COLOR_FOCUSED
		style			WINDOW_STYLE_EMPTY
		blurWorld		7
		onOpen
		{
			focusFirst;
		}
		onEsc
		{
			close self;
			open class;
		}

		// 1. Deep Black Immersive Background
		


