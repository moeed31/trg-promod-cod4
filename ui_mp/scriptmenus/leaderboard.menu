		// --- TABS ---
		itemDef {
			name			"tab_global"
			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_FILLED
			rect			20 60 150 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			background		"white"
			backcolor		0 0.3 0.7 0.5
			border			1
			bordercolor		0.3 0.3 0.3 0.5
			forecolor		0.7 0.7 0.7 1
			text			"GLOBAL RANKINGS"
			textfont		UI_FONT_OBJECTIVE
			textscale		0.25
			textalign		ITEM_ALIGN_CENTER
			textaligny		14
			visible			1
			mouseEnter		{ play "mouse_over"; setitemcolor "tab_global" bordercolor 0.5 0.7 1 0.8; }
			mouseExit		{ setitemcolor "tab_global" bordercolor 0.3 0.3 0.3 0.5; }
			action			{ play "mouse_click"; scriptMenuResponse "lb_tab_global"; }
		}

