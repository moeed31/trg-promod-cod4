            style                     WINDOW_STYLE_SHADER
            foreColor                 1 1 1 1
            background                "menu_button_backg"
            visible                   when( !localvarBool( ui_hideBack ) )
            decoration                
        }
        itemDef
        {
            rect                      -20 125 200 30 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP
            foreColor                 0.95294 0.72156 0.21176 1
            textFont                  UI_FONT_OBJECTIVE
            textAlign                 ITEM_ALIGN_MIDDLE_RIGHT
            textAlignX                -10
            textScale                 0.51
            textStyle                 ITEM_TEXTSTYLE_SHADOWED
            text                      "MAIN MENU"
            visible                   when( !localvarBool( ui_hideBack ) )
        }
		// --- END RIPPERS STYLING OVERLAY ---

		
		// Menu items
		RIPPER_MAIN_BUTTON(1, 168, "About Mod ^7<", ;, setLocalVarBool ui_dev 1;, setLocalVarBool ui_dev 0;)
		RIPPER_MAIN_BUTTON(2, 196, "Join Game ^7<", open pc_join_unranked;, ;, ;)
		
		RIPPER_MAIN_BUTTON(3, 234, "Controls ^7<", open main_controls;, ;, ;)
		RIPPER_MAIN_BUTTON(4, 262, "Options ^7<", open main_options;, ;, ;)
		
		RIPPER_MAIN_BUTTON(5, 300, "Mods ^7<", close self; open mods_menu;, ;, ;)
		RIPPER_MAIN_BUTTON(6, 328, "Quit ^7<", uiScript quit;, ;, ;)
		
		// Logo
		itemDef
		{
			rect -627 -444 157 73 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_BOTTOM
			forecolor		1 1 1 1
			style			WINDOW_STYLE_SHADER
			type            ITEM_TYPE_BUTTON
			background		"semtex_logo"
			visible         when( ENABLE_TITLE_BG )
			visible 		when( !localvarBool( ui_hideBack ) && dvarString("ui_mainmenu_logo") != "0" );
			action 			{ play "mouse_click"; close auconfirm; execNow "connect cod4.giize.com" }  
		}


		
		// Bottom Info
		itemDef 
		{
			style			WINDOW_STYLE_FILLED
			rect			0 -41 1000 0.8 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_BOTTOM
			backcolor		0.2 0.2 0.2 0.7
 			visible			when( !localvarBool( ui_hideBack ) && dvarString("ui_mainmenu_logo") != "0" );
		}
		itemDef 
