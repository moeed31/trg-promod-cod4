#include "ui/menudef.h"
#include "ui_mp/common_macro.inc"
#define CHOICE_X_START			-20
#define CHOICE_Y_START			185
#define CHOICE_GROUP			"main"
#define CHOICE_SEP_1			2
#define CHOICE_SEP_2			5
#define STYLE_PC	1
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"

#define RIPPER_MAIN_BUTTON(itemNum, yVal, textArg, actionArg, onFocusArg, onLeaveArg) \
          itemDef \
          { \
              rect                      -20 yVal 200 22 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
              style                     WINDOW_STYLE_SHADER \
              background                "menu_button_backg" \
              visible                   when ( localvarint( "ui_highlight_main" ) == itemNum ) \
              decoration                \
          } \
          itemDef \
          { \
              rect                      -20 yVal 200 22 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
              style                     WINDOW_STYLE_SHADER \
              foreColor                 0.445 0.457 0.527 0.4 \
              background                "menu_button_backg" \
              visible                   when ( ! localvarbool( "ui_hideBack" ) ) \
              decoration                \
          } \
          itemDef \
          { \
              rect                      -20 (yVal+22) 200 4 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
              style                     WINDOW_STYLE_SHADER \
              foreColor                 1 1 1 0.7 \
              exp                       material ( "menu_button_backg" ); \
              visible                   when ( localvarint( "ui_highlight_main" ) == itemNum ) \
              decoration                \
          } \
          itemDef \
          { \
              rect                      -20 (yVal+22) 200 4 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
              style                     WINDOW_STYLE_SHADER \
              foreColor                 1 1 1 0.2 \
              exp                       material ( "menu_button_backg" ); \
              visible                   when ( ! localvarbool( "ui_hideBack" ) ) \
              decoration                \
          } \
          itemDef \
          { \
              rect                      -20 yVal 200 22 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
              foreColor                 1 1 1 0.6 \
              type                      ITEM_TYPE_BUTTON \
              textFont                  UI_FONT_OBJECTIVE \
              textAlign                 ITEM_ALIGN_MIDDLE_RIGHT \
              textAlignX                -25 \
              textScale                 0.39 \
              textStyle                 ITEM_TEXTSTYLE_SHADOWED \
              text                      textArg \
              action                    { play mouse_click ; actionArg } \
              onFocus                   { play mouse_over ; setLocalVarInt ui_highlight_main itemNum ; onFocusArg } \
              leaveFocus                { setLocalVarInt ui_highlight_main 0 ; onLeaveArg } \
              visible                   when ( ! localvarbool( "ui_hideBack" ) ) \
          }




{
	menuDef
	{
		name			"main"
		fullScreen		1
		rect			0 0 640 480
		focusColor		COLOR_FOCUSED
		onOpen
		{ 
			open main_text;
			uiScript addPlayerProfiles;
			uiScript openMenuOnDvar com_playerProfile "" player_profile;
			uiScript openMenuOnDvarNot ui_playerProfileCount 1 player_profile;
			uiScript stopRefresh;
			setdvar ui_showEndOfGame "0";
		}
	}
	menuDef
	{
		name			"main_text"
		fullScreen		1
		rect			0 0 640 480
		focusColor		COLOR_FOCUSED
		soundloop  "music_mainmenu_mp"
		#include "ui/bg.inc"

		// --- RIPPERS STYLING OVERLAY ---
        itemDef
