#include "ui/menudef.h"
#include "ui_mp/common_macro.inc"
{	
	menuDef
	{
	    rect            FULLSCREEN_WIDE
		name			"error_popmenu"
		fullScreen		1
		visible			1		
		onClose
		{
			uiScript clearError;
		}
		onEsc
		{
			uiScript clearError;
			close error_popmenu;
			open main_text;
		}
		
		//Background
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			FULLSCREEN_WIDE
			backcolor		0.05 0.05 0.05 0.95
			visible			1
			decoration
		}

